# B2B — Apache 2.4
# Angular build: frontend/dist/b2b-admin/browser
#
# Canlı (alt alan adı kökü, örn. https://b2b.site.com/): RewriteBase /
# Yerel XAMPP alt klasör (http://localhost/b2b/): RewriteBase /b2b/ ve `ng build --configuration=xampp`
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# .sql dosyalarına tarayıcıdan erişimi kapat
RewriteCond %{REQUEST_URI} \.sql(?:$|\?) [NC]
RewriteRule ^ - [F,L]

# API (PHP)
RewriteRule ^api/ - [L]

# Bu dizinde doğrudan var olan dosya veya klasör (build köke kopyalandıysa burada biter)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Derleme çıktısı alt klasördeyse statik dosyaları oradan ver
RewriteCond %{DOCUMENT_ROOT}/b2b/frontend/dist/b2b-admin/browser/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/frontend/dist/b2b-admin/browser/$1 -f
RewriteRule ^(.*)$ frontend/dist/b2b-admin/browser/$1 [L]

# Bilinen statik uzantılar: dosya yoksa index.html VERME (yanlış MIME → "Failed to fetch dynamically imported module")
RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|json|webp|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|webmanifest)$ [NC]
RewriteRule ^ - [R=404,L]

# SPA (yalnızca “sayfa” rotaları)
RewriteRule ^.*$ frontend/dist/b2b-admin/browser/index.html [L]
</IfModule>

DirectoryIndex frontend/dist/b2b-admin/browser/index.html
