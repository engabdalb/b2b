# B2B — Apache 2.4 (XAMPP / üretim)
# Angular: frontend/dist/b2b-admin/browser (src/index.html derlemesi).
# Alt dizin /b2b/ için: frontend içinde `ng build --configuration=xampp`
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On
# Alt klasör kurulumu: http://localhost/b2b/ — sanal host kökü doğrudan bu klasörse RewriteBase /
RewriteBase /b2b/

# .sql dosyalarına tarayıcıdan erişimi kapat (api/schema.sql, migrations, backups, vb.)
RewriteCond %{REQUEST_URI} \.sql(?:$|\?) [NC]
RewriteRule ^ - [F,L]

# API (PHP) — yönlendirme yok
RewriteRule ^api/ - [L]

# Bu dizinde doğrudan var olan dosya veya klasör
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Angular build içindeki statik dosyalar (js, css, media, assets, …)
# XAMPP: DocumentRoot genelde htdocs → …/htdocs/b2b/… | Sanal host kökü b2b ise …/b2b/…
RewriteCond %{DOCUMENT_ROOT}/b2b/frontend/dist/b2b-admin/browser/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/frontend/dist/b2b-admin/browser/$1 -f
RewriteRule ^(.*)$ frontend/dist/b2b-admin/browser/$1 [L]

# SPA: client route’lar → index.html
RewriteRule ^.*$ frontend/dist/b2b-admin/browser/index.html [L]
</IfModule>

DirectoryIndex frontend/dist/b2b-admin/browser/index.html
